{
  "name": "pilecrawl",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --external:node:* --outfile=dist-server/server.mjs && esbuild server/updater-cli.ts --bundle --platform=node --target=node22 --format=esm --external:node:* --outfile=dist-server/updater.mjs",
    "server": "npm run build:server && node dist-server/server.mjs"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.0"
  }
}
